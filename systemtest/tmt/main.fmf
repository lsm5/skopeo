require:
    - git-core
    - make
    - skopeo-tests

environment:
    SKOPEO_BINARY: /usr/bin/skopeo

adjust:
    - when: initiator != "packit"
      environment+:
        RELEASE_TESTING: true

summary: System test
test: |
    rpm -q containers-common skopeo skopeo-tests
    make -C $(git rev-parse --show-toplevel) test-system-local
duration: 60m
